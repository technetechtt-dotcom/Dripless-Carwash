# Staging on Neon + Render (DEPLOY_ENV=staging softens production hard-gates)
NODE_ENV=production
DEPLOY_ENV=staging
DEMO_MODE=true
PORT=4000
PROCESS_ROLE=all

# Neon pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Render Key Value (auto-wired in render.yaml)
REDIS_URL=redis://red-xxxx:6379

PUBLIC_API_URL=https://dripless-api.onrender.com
CUSTOMER_APP_URL=https://dripless-customer.onrender.com
DRIVER_APP_URL=https://dripless-driver.onrender.com
OPS_APP_URL=https://dripless-ops.onrender.com
CORS_ORIGINS=https://dripless-customer.onrender.com,https://dripless-driver.onrender.com,https://dripless-ops.onrender.com
WEBAUTHN_RP_ID=dripless-ops.onrender.com
WEBAUTHN_ORIGIN=https://dripless-ops.onrender.com

PAYMENTS_PROVIDER=stub
GEOCODER_PROVIDER=none
ROUTING_PROVIDER=none
EVIDENCE_STORAGE_PROVIDER=local
MFA_REQUIRED_OPS=false
MFA_ENC_KEY=replace-with-32-plus-char-staging-key!!
COMPLETION_PIN_PEPPER=replace-with-32-plus-char-staging-pepper!
