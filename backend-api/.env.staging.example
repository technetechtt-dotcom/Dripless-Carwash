# Staging environment — use Paystack TEST keys here
NODE_ENV=production
DEMO_MODE=false
PORT=4000
PROCESS_ROLE=api

# Staging database (separate from production)
STAGING_DATABASE_URL=postgresql://USER:PASSWORD@STAGING-HOST/dripless_staging?sslmode=require

# Staging Redis (separate from production)
STAGING_REDIS_URL=redis://STAGING-REDIS-HOST:6379

# Staging front-end URLs
STAGING_CUSTOMER_URL=https://staging-customer.dripless.co.za
STAGING_DRIVER_URL=https://staging-driver.dripless.co.za
STAGING_OPS_URL=https://staging-ops.dripless.co.za
STAGING_WEBAUTHN_RP_ID=staging-ops.dripless.co.za
STAGING_WEBAUTHN_ORIGIN=https://staging-ops.dripless.co.za

# Paystack TEST keys (optional while Ozow is primary)
STAGING_PAYSTACK_SK=sk_test_REPLACE_ME
STAGING_PAYSTACK_PK=pk_test_REPLACE_ME
STAGING_PAYSTACK_CALLBACK_URL=https://staging-customer.dripless.co.za/payment-return

# Ozow TEST credentials (primary payment provider)
PAYMENTS_PROVIDER=ozow
OZOW_SITE_CODE=REPLACE_ME
OZOW_API_KEY=REPLACE_ME
OZOW_PRIVATE_KEY=REPLACE_ME
OZOW_IS_TEST=true
OZOW_NOTIFY_URL=https://staging-api.dripless.co.za/payments/webhooks/ozow
OZOW_API_BASE_URL=https://api.ozow.com
PUBLIC_API_URL=https://staging-api.dripless.co.za
CUSTOMER_APP_URL=https://staging-customer.dripless.co.za

# Staging S3-compatible storage (can share bucket with staging prefix)
STAGING_S3_BUCKET=dripless-evidence-staging
STAGING_S3_ACCESS_KEY=REPLACE_ME
STAGING_S3_SECRET_KEY=REPLACE_ME
STAGING_S3_ENDPOINT=

# Security secrets (must be 32+ chars, different from production)
STAGING_MFA_ENC_KEY=REPLACE_WITH_32_PLUS_CHAR_STAGING_KEY
STAGING_COMPLETION_PIN_PEPPER=REPLACE_WITH_32_PLUS_CHAR_STAGING_PEPPER

# Monitoring (staging Sentry project)
STAGING_SENTRY_DSN=https://REPLACE_ME@sentry.io/PROJECT_ID

# Shared across staging and production
GEOCODER_PROVIDER=google
ROUTING_PROVIDER=google
GOOGLE_MAPS_API_KEY=REPLACE_ME
MAPBOX_ACCESS_TOKEN=
S3_REGION=af-south-1
RESEND_API_KEY=re_REPLACE_ME
FCM_SERVICE_ACCOUNT_JSON=
ALERT_WEBHOOK_URL=
VAT_RATE_BPS=0
VAT_NUMBER=
MALWARE_SCAN_URL=
