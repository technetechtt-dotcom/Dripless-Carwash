# Production environment — use Paystack LIVE keys only here
NODE_ENV=production
DEMO_MODE=false
PORT=4000
PROCESS_ROLE=api

# Managed PostgreSQL (Neon / Supabase / RDS etc — never shared with staging)
DATABASE_URL=postgresql://USER:PASSWORD@PROD-HOST/dripless?sslmode=require

# Managed Redis (separate from staging)
REDIS_URL=redis://PROD-REDIS-HOST:6379

# Production app URLs
CUSTOMER_APP_URL=https://customer.dripless.co.za
DRIVER_APP_URL=https://driver.dripless.co.za
OPS_APP_URL=https://ops.dripless.co.za
WEBAUTHN_RP_ID=ops.dripless.co.za
WEBAUTHN_ORIGIN=https://ops.dripless.co.za

# Ozow LIVE credentials — primary SA instant EFT (never put these in staging)
PAYMENTS_PROVIDER=ozow
OZOW_SITE_CODE=REPLACE_ME
OZOW_API_KEY=REPLACE_ME
OZOW_PRIVATE_KEY=REPLACE_ME
OZOW_IS_TEST=false
OZOW_NOTIFY_URL=https://api.dripless.co.za/payments/webhooks/ozow
OZOW_API_BASE_URL=https://api.ozow.com
PUBLIC_API_URL=https://api.dripless.co.za

# Paystack LIVE keys — optional secondary / payouts
PAYSTACK_SECRET_KEY=sk_live_REPLACE_ME
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_ME
PAYSTACK_CALLBACK_URL=https://customer.dripless.co.za/payment-return

# Geocoding / Routing
GEOCODER_PROVIDER=mapbox
ROUTING_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=pk.REPLACE_ME
# GOOGLE_MAPS_API_KEY=

# Auth secrets (32+ chars, unique per environment, rotate periodically)
MFA_ENC_KEY=REPLACE_WITH_32_PLUS_CHAR_PRODUCTION_KEY
COMPLETION_PIN_PEPPER=REPLACE_WITH_32_PLUS_CHAR_PRODUCTION_PEPPER
MFA_REQUIRED_OPS=true

# Email delivery (Resend)
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=Dripless <noreply@dripless.co.za>

# SMS delivery (Twilio / Africa's Talking)
REQUIRE_SMS_DELIVERY=true
TWILIO_ACCOUNT_SID=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_FROM=+27XXXXXXXXX

# S3-compatible object storage (private bucket, af-south-1 for POPIA)
EVIDENCE_STORAGE_PROVIDER=s3
S3_BUCKET=dripless-evidence-production
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_ENDPOINT=
S3_REGION=af-south-1
S3_FORCE_PATH_STYLE=false
EVIDENCE_MAX_BYTES=8388608
EVIDENCE_RETENTION_DAYS=90
DRIVER_DOCUMENT_RETENTION_DAYS=365
GPS_RETENTION_DAYS=30

# Firebase Cloud Messaging (paste the full service account JSON as one-line base64)
FCM_SERVICE_ACCOUNT_JSON=

# Malware scanning (ClamAV REST or VirusTotal)
MALWARE_SCAN_URL=http://clamav-rest:8080/scan

# VAT
VAT_RATE_BPS=0
VAT_NUMBER=

# Error monitoring
SENTRY_DSN=https://REPLACE_ME@sentry.io/PROJECT_ID

# Operational alert webhook (Slack incoming webhook or similar)
ALERT_WEBHOOK_URL=https://hooks.slack.com/REPLACE_ME

# Invoice generation
INVOICE_RENDERER_PATH=src/invoices/generate_invoice.py
PYTHON_BIN=python3
