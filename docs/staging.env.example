# Copy to `.env.staging` on the staging host (never commit real values).
# Used with: docker compose --env-file .env.staging -f docker-compose.staging.yml up -d

# Core
STAGING_DATABASE_URL=postgresql://user:pass@host:5432/dripless_staging
STAGING_REDIS_URL=redis://host:6379
STAGING_PUBLIC_API_URL=https://api.staging.dripless.co.za

# App URLs (CORS + deep links)
STAGING_CUSTOMER_URL=https://customer.staging.dripless.co.za
STAGING_DRIVER_URL=https://driver.staging.dripless.co.za
STAGING_OPS_URL=https://ops.staging.dripless.co.za

# WebAuthn (must match staging hostnames)
STAGING_WEBAUTHN_RP_ID=staging.dripless.co.za
STAGING_WEBAUTHN_ORIGIN=https://ops.staging.dripless.co.za

# Ozow sandbox (real staging payments)
STAGING_OZOW_SITE_CODE=
STAGING_OZOW_API_KEY=
STAGING_OZOW_PRIVATE_KEY=
STAGING_OZOW_NOTIFY_URL=https://api.staging.dripless.co.za/payments/webhooks/ozow

# Private object storage (driver evidence, uploads)
STAGING_S3_BUCKET=dripless-staging-evidence
STAGING_S3_ACCESS_KEY=
STAGING_S3_SECRET_KEY=
STAGING_S3_ENDPOINT=
S3_REGION=af-south-1

# FCM (Firebase service account JSON as single-line string)
FCM_SERVICE_ACCOUNT_JSON=

# Security peppers (generate unique values per environment)
STAGING_MFA_ENC_KEY=
STAGING_COMPLETION_PIN_PEPPER=

# Optional
GEOCODER_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
RESEND_API_KEY=
STAGING_SENTRY_DSN=
ALERT_WEBHOOK_URL=

# GitHub Actions: set as repository secret to trigger remote deploy after image build
# DEPLOY_WEBHOOK_URL=https://staging-host/deploy/hook?token=...
